h1
  = "#{@year}年#{@month}月の明細"
= form_with url: statements_path, method: :get, class: "form-card mb-16" do |form|
  .form-inline
    = form.label :year, "年"
    = form.select :year, (2024..Date.current.year).to_a.reverse, selected: @year
    = form.label :month, "月"
    = form.select :month, (1..12).to_a, selected: @month
    = form.submit "表示"
- if @statements.empty?
  p.empty この月の明細はありません。
- else
  table
    thead
      tr
        th 日付
        th 支払い先
        th 摘要
        th 金額
        th 支払者
        th 負担者
        th
    tbody
      - @statements.each do |statement|
        tr
          td = statement.date.strftime("%m/%d")
          td = statement.payee&.name
          td = statement.description
          td.amount = number_to_currency(statement.amount, unit: "¥", precision: 0)
          td = t("enums.statement.paid_by.#{statement.paid_by}")
          td = t("enums.statement.charged_to.#{statement.charged_to}")
          td.actions
            = link_to "編集", edit_statement_path(statement)
            = link_to "削除", statement_path(statement), data: { turbo_method: :delete, turbo_confirm: "削除しますか？" }
