h1
  | 明細編集
- if @statement.errors.any?
  #error_explanation
    ul
      - @statement.errors.full_messages.each do |message|
        li
          = message
= form_with(model: @statement, class: "form-card") do |form|
  .form-field
    = form.label :date
    = form.date_field :date
  .form-field
    = form.label :amount
    = form.number_field :amount, min: 1
  .form-field
    = form.label :payee_id, "支払い先"
    = form.collection_select :payee_id, Payee.order(:name), :id, :name, prompt: "選択してください"
  .form-field
    = form.label :description
    = form.text_field :description
  .form-field
    = form.label :paid_by
    = form.select :paid_by, [["妻", "wife"], ["夫", "husband"], ["共用口座", "shared_account"]]
  .form-field
    = form.label :charged_to
    = form.select :charged_to, [["妻", "wife"], ["夫", "husband"], ["共用", "shared"]]
  .form-actions
    = form.submit
