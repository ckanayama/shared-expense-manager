.settlement-header
  h1
    = t("settlement.title", year: @settlement.year, month: @settlement.month)
  - if @confirmed
    span.confirmed-badge 確定済み
  - else
    = button_to "確定する", settlement_confirmation_path(year: @settlement.year, month: @settlement.month), method: :post, class: "btn-confirm", data: { turbo_confirm: "この月の精算を確定しますか？" }
= form_with url: settlement_path, method: :get, class: "form-card mb-0" do |form|
  .form-inline
    = form.label :year, "年"
    = form.select :year, (2024..Date.current.year).to_a.reverse, selected: @settlement.year
    = form.label :month, "月"
    = form.select :month, (1..12).to_a, selected: @settlement.month
    = form.submit "表示"

- total = @settlement.husband_to_wife_total
.message-section
  .character
    - if (src = random_character_image)
      = image_tag src, class: "character-img"
    - else
      .character-face
  div
    .message-label 夫へ
    .speech-bubble
      - if total > 0
        = t("settlement.message_husband_pays", amount: number_to_currency(total, unit: "¥", precision: 0))
      - elsif total < 0
        = t("settlement.message_wife_pays", amount: number_to_currency(-total, unit: "¥", precision: 0))
      - else
        = t("settlement.message_even")

- repay_total = @settlement.repay_total
.message-section
  .character
    - if (src = random_character_image)
      = image_tag src, class: "character-img"
    - else
      .character-face
  div
    .message-label 妻へ
    .speech-bubble
      - if repay_total > 0
        = t("settlement.message_wife_task_repay", amount: number_to_currency(repay_total, unit: "¥", precision: 0))
      - else
        = t("settlement.message_wife_nothing")

hr

h2
  = t("settlement.direct")

table
  thead
    tr
      th = Statement.human_attribute_name(:paid_by)
      th = Statement.human_attribute_name(:charged_to)
      th = Statement.human_attribute_name(:amount)
  tbody
    tr
      td = t("enums.statement.paid_by.husband")
      td = t("enums.statement.paid_by.wife")
      td.amount = number_to_currency(@settlement.direct.to_wife, unit: "¥", precision: 0)
    tr
      td = t("enums.statement.paid_by.wife")
      td = t("enums.statement.paid_by.husband")
      td.amount = number_to_currency(@settlement.direct.to_husband, unit: "¥", precision: 0)
- direct = @settlement.direct
p.settlement-result
  - if direct.to_wife > direct.to_husband
    = t("settlement.net_to_husband", amount: number_to_currency(direct.to_wife - direct.to_husband, unit: "¥", precision: 0))
  - elsif direct.to_husband > direct.to_wife
    = t("settlement.net_to_wife", amount: number_to_currency(direct.to_husband - direct.to_wife, unit: "¥", precision: 0))
  - else
    = t("settlement.net_zero")

h2
  = t("settlement.shared")
table
  thead
    tr
      th = Statement.human_attribute_name(:paid_by)
      th = Statement.human_attribute_name(:charged_to)
      th = Statement.human_attribute_name(:amount)
  tbody
    tr
      td = t("enums.statement.paid_by.husband")
      td = t("enums.statement.charged_to.shared")
      td.amount = number_to_currency(@settlement.shared.husband_paid, unit: "¥", precision: 0)
    tr
      td = t("enums.statement.paid_by.wife")
      td = t("enums.statement.charged_to.shared")
      td.amount = number_to_currency(@settlement.shared.wife_paid, unit: "¥", precision: 0)
- shared = @settlement.shared
p.settlement-result
  - if shared.to_wife > 0
    = t("settlement.net_to_husband", amount: number_to_currency(shared.to_wife, unit: "¥", precision: 0))
  - elsif shared.to_husband > 0
    = t("settlement.net_to_wife", amount: number_to_currency(shared.to_husband, unit: "¥", precision: 0))
  - else
    = t("settlement.net_zero")

h2
  = t("settlement.shared_card")
table
  thead
    tr
      th = Statement.human_attribute_name(:paid_by)
      th = Statement.human_attribute_name(:charged_to)
      th = Statement.human_attribute_name(:amount)
  tbody
    tr
      td = t("enums.statement.paid_by.shared_account")
      td = t("enums.statement.paid_by.wife")
      td.amount = number_to_currency(@settlement.shared_card.to_wife, unit: "¥", precision: 0)
    tr
      td = t("enums.statement.paid_by.shared_account")
      td = t("enums.statement.paid_by.husband")
      td.amount = number_to_currency(@settlement.shared_card.to_husband, unit: "¥", precision: 0)
- card = @settlement.shared_card
p.settlement-result
  - if card.to_wife > 0 || card.to_husband > 0
    - if card.to_wife > 0
      = t("settlement.repay_wife", amount: number_to_currency(card.to_wife, unit: "¥", precision: 0))
    - if card.to_wife > 0 && card.to_husband > 0
      br
    - if card.to_husband > 0
      = t("settlement.repay_husband", amount: number_to_currency(card.to_husband, unit: "¥", precision: 0))
  - else
    = t("settlement.net_zero")

