h1
  = t("settlement.title", year: @settlement.year, month: @settlement.month)
p
  = link_to "明細を入力する", new_statement_path
  |  /
  = link_to "この月の明細一覧", statements_path(year: @settlement.year, month: @settlement.month)
= form_with url: settlement_path, method: :get do |form|
  div
    = form.label :year, "年"
    = form.select :year, (2024..Date.current.year).to_a.reverse, selected: @settlement.year
    = form.label :month, "月"
    = form.select :month, (1..12).to_a, selected: @settlement.month
    = form.submit "表示"

h2
  = t("settlement.direct")
table
  thead
    tr
      th = Statement.human_attribute_name(:paid_by)
      th = Statement.human_attribute_name(:charged_to)
      th = Statement.human_attribute_name(:amount)
  tbody
    tr
      td = t("enums.statement.paid_by.husband")
      td = t("enums.statement.paid_by.wife")
      td = number_to_currency(@settlement.direct.to_wife, unit: "¥", precision: 0)
    tr
      td = t("enums.statement.paid_by.wife")
      td = t("enums.statement.paid_by.husband")
      td = number_to_currency(@settlement.direct.to_husband, unit: "¥", precision: 0)

